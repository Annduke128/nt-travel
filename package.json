{
  "name": "nt-travel-bedbank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "RAYON_NUM_THREADS=1 vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node server-dist/server/index.js",
    "build": "RAYON_NUM_THREADS=1 vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server shared",
    "bootstrap:admin": "tsx server/auth/bootstrap-admin.ts",
    "smoke:cloudhms": "tsx server/cloudhms/smoke.ts",
    "test": "RAYON_NUM_THREADS=1 vitest run --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:watch": "RAYON_NUM_THREADS=1 vitest --pool=forks --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "oxlint": "^1.74.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "latest",
    "vitest": "latest"
  }
}
