{
  "name": "nt-travel-bedbank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "RAYON_NUM_THREADS=1 vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node server-dist/server/index.js",
    "build": "RAYON_NUM_THREADS=1 vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run check:static && npm test && npm run check:build",
    "check:static": "npm run lint && npm run typecheck",
    "check:build": "npm run build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server shared",
    "bootstrap:admin": "tsx server/auth/bootstrap-admin.ts",
    "bootstrap:admin:production": "node server-dist/server/auth/bootstrap-admin.js",
    "check:cloudhms": "tsx server/cloudhms/connectivity.ts",
    "check:cloudhms:production": "node server-dist/server/cloudhms/connectivity.js",
    "smoke:cloudhms": "tsx server/cloudhms/smoke.ts",
    "smoke:cloudhms:production": "node server-dist/server/cloudhms/smoke.js",
    "test": "RAYON_NUM_THREADS=1 vitest run --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:watch": "RAYON_NUM_THREADS=1 vitest --pool=forks --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "oxlint": "1.74.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
